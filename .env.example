# Configuration for the local 24/7 bot server. Copy to .env to override defaults.

# Port the bot server listens on (loopback / 127.0.0.1 only). Default: 3000
PORT=3000

# Optional comma-separated allowlist of license keys accepted by /api/auth/verify.
# When unset, any non-empty key activates the single-user local bot.
VALID_LICENSE_KEYS=
